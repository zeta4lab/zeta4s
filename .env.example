# ============================================================
# zeta4s — 로컬 개발 스택 환경 변수
# 사용법: bash scripts/configure_open_env.sh --force  →  필요한 값만 수정
# 버전은 2026-07 기준 PyPI latest 호환 페어
# ============================================================

# ── 버전 고정 ─────────────────────────────────────────────────
AIRFLOW_VERSION=3.3.0
AIRFLOW_IMAGE=apache/airflow:3.3.0-python3.12
# prefect-server 는 공식 이미지를 쓴다. zeta4s-api 의 prefect SDK pin 과 맞춰야 한다 —
# 정본은 packages/zeta4s-api/pyproject.toml 이고 gate 가 대조한다.
PREFECT_VERSION=3.7.8
PYTHON_VERSION=3.12
ZETA4S_VERSION=
# zeta4s가 빌드하는 runtime image는 zeta4s-api 하나다. Airflow는 위 공식 image를 쓴다.
ZETA4S_API_IMAGE=
METASTORE_VERSION=26.4
POSTGRES_VERSION=18.4-alpine
ELASTICSEARCH_VERSION=8.15.4
KIBANA_VERSION=8.15.4
PROMETHEUS_VERSION=v3.13.0
GRAFANA_VERSION=13.0.3
STATSD_EXPORTER_VERSION=v0.30.0-distroless
ALERTMANAGER_VERSION=v0.33.1
LAKEKEEPER_IMAGE=quay.io/lakekeeper/catalog:v0.13.1
CURL_IMAGE=curlimages/curl:8.17.0
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_CLIENT_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z

# ── 호스트 노출 포트 (충돌 시 수정) ───────────────────────────
AIRFLOW_PORT=18080
ZETA4S_API_HOST_PORT=18088
# ZETA4S_API_TOKEN 이 비어 있으면 zeta4s-api 인증을 생략한다.
# 외부 접속 가능한 host 에서는 반드시 충분히 긴 임의 token 으로 설정한다.
ZETA4S_API_TOKEN=
# generated Airflow DAG task가 zeta4s-api internal endpoint를 호출할 때 쓰는 전용 token.
# scripts/configure_open_env.sh 가 .env 생성 시 랜덤 값을 채운다.
ZETA4S_RUNTIME_INTERNAL_TOKEN=
# 기본 metastore는 같은 PostgreSQL service의 별도 database를 사용한다.
# ClickHouse adapter 회귀 시 ZETA4S_METASTORE_TYPE=clickhouse와 asset profile을 함께 사용한다.
ZETA4S_METASTORE_TYPE=postgres
ZETA4S_METASTORE_DSN=postgresql://airflow:airflow@postgres:5432/zeta4s_metastore
POSTGRES_BIND_HOST=0.0.0.0
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
ORACLE_PORT=11521
ELASTICSEARCH_PORT=19200
KIBANA_PORT=15601
METASTORE_HTTP_PORT=18123
METASTORE_TCP_PORT=19000
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
STATSD_EXPORTER_PORT=19102
STATSD_EXPORTER_STATSD_PORT=19125
ALERTMANAGER_PORT=19093
LAKEKEEPER_PORT=18181
MINIO_API_PORT=19002
MINIO_CONSOLE_PORT=19092

# ── Iceberg rowset checkpoint platform ──────────────────────
# scheduler-projected service 내부 주소다. authoring/profile 계약에 노출하지 않는다.
ZETA4S_ICEBERG_CATALOG_URI=http://lakekeeper:8181/catalog
ZETA4S_ICEBERG_WAREHOUSE=warehouse
ZETA4S_ICEBERG_CATALOG_TOKEN=
# 아래 값은 로컬 checkpoint profile 전용이며 운영 credential 계약이 아니다.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
LAKEKEEPER_PG_ENCRYPTION_KEY=This-is-NOT-Secure!

# ── Runtime operation timeout ───────────────────────────────
# deploy/undeploy/redeploy 내부 대기와 CLI/API timeout 정합을 맞추기 위한 값이다.
# 비워두면 코드 기본값을 사용한다.
ZETA4S_OPERATION_LOCK_TIMEOUT=
ZETA4S_RUNTIME_OPERATION_TIMEOUT_MARGIN_SECONDS=
ZETA4S_DEPLOY_DAG_DISCOVERY_TIMEOUT_SECONDS=
ZETA4S_DEPLOY_DAG_STATE_TIMEOUT_SECONDS=
ZETA4S_UNDEPLOY_DAG_STATE_TIMEOUT_SECONDS=
ZETA4S_UNDEPLOY_ACTIVE_TERMINATE_TIMEOUT_SECONDS=
ZETA4S_UNDEPLOY_DAG_DELETE_TIMEOUT_SECONDS=
ZETA4S_AIRFLOW_OPERATION_POLL_SECONDS=
ZETA4S_AIRFLOW_ACTIVE_TERMINATE_POLL_SECONDS=
ZETA4S_CLI_RUNTIME_OPERATION_TIMEOUT_SECONDS=
# zeta4s-api 는 Airflow 를 REST 로만 다룬다. 값을 비우면 docker-compose.yml 의 개발
# 기본값(airflow-apiserver + SimpleAuthManager passwords 파일)을 쓴다.
# TOKEN 을 직접 주면 그대로 쓰지만 Airflow JWT 는 24h 만료라 갱신되지 않는다.
# USERNAME/PASSWORD 를 주면 client 가 JWT 를 발급·재발급한다. basic auth 는 쓰지 않는다.
ZETA4S_AIRFLOW_REST_API_BASE_URL=
ZETA4S_AIRFLOW_REST_API_TOKEN=
ZETA4S_AIRFLOW_REST_API_USERNAME=
ZETA4S_AIRFLOW_REST_API_PASSWORD=
# PASSWORD 대신 파일로 줄 수 있다. SimpleAuthManager 형식({"admin": "pw"})과 평문 한 줄을
# 모두 받는다. PASSWORD 가 있으면 그쪽이 이긴다.
ZETA4S_AIRFLOW_REST_API_PASSWORD_FILE=
ZETA4S_AIRFLOW_REST_API_TIMEOUT_SECONDS=

# ── Airflow 관리자 ────────────────────────────────────────────
# Airflow 3.x SimpleAuthManager 비밀번호는
# docker/airflow/simple_auth_manager_passwords.json 에서 고정한다.
# 기본 로그인: admin / admin

# Airflow runtime UID. zeta4s 로컬 stack 은 이 값을 고정으로 사용한다.
AIRFLOW_UID=50000
# zeta4s-api와 Prefect worker가 공유하는 runtime state UID다.
ZETA4S_RUNTIME_UID=50000

# ── Oracle ────────────────────────────────────────────────────
# 로컬 공개망 기본 gvenzl/oracle-free:23-slim 컨테이너 SYS/SYSTEM 비밀번호. 실서비스 절대 사용 금지
ORACLE_PASSWORD=oracle

# ── Elasticsearch ────────────────────────────────────────────
# 로컬 demo publish target. 필요 시 JVM heap을 호스트 메모리에 맞춰 조정한다.
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# ── Grafana ───────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
