{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "refresh_interval": "-1"
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "sale_id": {"type": "long"},
      "store_id": {"type": "integer"},
      "product_id": {"type": "integer"},
      "customer_id": {"type": "keyword"},
      "quantity": {"type": "short"},
      "unit_price_cents": {"type": "integer"},
      "amount_cents": {"type": "long"},
      "amount": {"type": "scaled_float", "scaling_factor": 100},
      "discount_rate": {"type": "float"},
      "is_priority": {"type": "boolean"},
      "sold_date": {"type": "date", "format": "strict_date"},
      "sold_at": {"type": "date", "format": "strict_date_optional_time"}
    }
  }
}
